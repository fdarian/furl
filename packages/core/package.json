{
  "name": "furl-lib",
  "version": "0.0.0",
  "description": "Fetch any URL as markdown with a pluggable resolver chain. Runs on Node, Bun and other runtimes.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdarian/furl.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "check:tsc": "tsrs --noEmit && tsrs --noEmit -p tsconfig.build.json",
    "check:lint": "biome check .",
    "test": "bun test"
  },
  "peerDependencies": {
    "effect": "^4.1.0"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "effect": "catalog:",
    "tsrs": "catalog:"
  }
}
