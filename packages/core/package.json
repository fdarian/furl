{
  "name": "furl-core",
  "version": "0.1.0",
  "description": "Fetch any URL as markdown with a pluggable resolver chain. Runs on Node, Bun and other runtimes.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdarian/furl.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "check:type": "tsrs --noEmit && tsrs --noEmit -p tsconfig.build.json",
    "check:lint": "biome lint .",
    "test": "bun test"
  },
  "peerDependencies": {
    "effect": "^4.1.0"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "tsrs": "catalog:"
  }
}
